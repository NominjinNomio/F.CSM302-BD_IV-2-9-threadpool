% =============================================================================
%  shutis.sty — ШУТИС, F.CSM302 бие даалтын баримт бичгийн загвар (XeLaTeX)
%
%  Албан хэрэг хөтлөлтийн шаардлага:
%   * Фонт: Arial (байхгүй бол хэмжээгээрээ ижил Liberation Sans), 12pt;
%     бүлгийн гарчиг 14pt.
%   * Хуудасны дугаар: доод талын голд араб тоогоор (нүүр хуудас дугааргүй).
%   * Нүүр хуудас: лого, байгууллагын нэр, баримтын нэр, тэргүү (сэдэв), дугаар,
%     огноо, үйлдсэн газар, гарын үсэг.
%  Overleaf: Menu → Compiler → XeLaTeX (latexmkrc файл үүнийг автоматаар сонгоно).
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{shutis}[2026/10/29 SHUTIS F.CSM302 report style]

% ---------------- Хуудас ----------------
\RequirePackage[a4paper, left=30mm, right=15mm, top=20mm, bottom=20mm,
                footskip=10mm, includefoot=false]{geometry}
\RequirePackage{setspace}
\setstretch{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\emergencystretch=3em
\tolerance=1500

% ---------------- Фонт ----------------
\RequirePackage{fontspec}
\IfFontExistsTF{Arial}
  {\setmainfont{Arial}\newfontfamily\pagenofont{Arial}}
  {\setmainfont{LiberationSans}[Path=fonts/, Extension=.ttf,
     UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]%
   \newfontfamily\pagenofont{LiberationSans-Regular}[Path=fonts/, Extension=.ttf]}
\setmonofont{DejaVuSansMono}[Path=fonts/, Extension=.ttf, Scale=0.88,
   UprightFont=*, BoldFont=*-Bold, ItalicFont=*-Oblique, BoldItalicFont=*-BoldOblique]
\newfontfamily\symfont{DejaVuSans}[Path=fonts/, Extension=.ttf]
\RequirePackage{newunicodechar}
\newunicodechar{✓}{{\symfont ✓}}
\newunicodechar{✕}{{\symfont ✕}}
\newunicodechar{▶}{{\symfont ▶}}
\newunicodechar{◀}{{\symfont ◀}}
\newunicodechar{‖}{{\symfont ‖}}

% ---------------- Өнгө ----------------
\RequirePackage[table]{xcolor}
\definecolor{headblue}{HTML}{4A5A78}
\definecolor{tablerule}{HTML}{C9C9C9}
\definecolor{tablehead}{HTML}{BDD7EE}
\definecolor{codekw}{HTML}{3B5B8F}
\definecolor{codecm}{HTML}{8A8A8A}
\definecolor{codestr}{HTML}{6B6B6B}
\definecolor{barfill}{HTML}{EEF0F3}
\definecolor{barline}{HTML}{DCDFE4}
\definecolor{frameline}{HTML}{D2D2D2}

% ---------------- Гарчиг ----------------
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\newcommand{\mnword}[1]{\ifcase#1\or НЭГ\or ХОЁР\or ГУРАВ\or ДӨРӨВ\or ТАВ\or ЗУРГАА\or ДОЛОО\or НАЙМ\or ЕС\or АРАВ\or АРВАН НЭГ\or АРВАН ХОЁР\fi}
\renewcommand{\thesection}{\mnword{\value{section}}}
\renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}
\titleformat{\section}{\fontsize{14}{17}\selectfont\bfseries\color{headblue}}{\thesection.}{0.35em}{\MakeUppercase}
\titleformat{name=\section, numberless}{\fontsize{14}{17}\selectfont\bfseries\color{headblue}}{}{0pt}{\MakeUppercase}
\titlespacing*{\section}{0pt}{20pt}{10pt}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}
\renewcommand{\contentsname}{Гарчиг}
\titlecontents{section}[0pt]{\addvspace{8pt}}
  {\textbf{\thecontentslabel.}\ \itshape}{\itshape}{\titlerule*[0.5em]{.}\contentspage}
\titlecontents{subsection}[3.9em]{\addvspace{1pt}}
  {\contentslabel{2.3em}}{}{\titlerule*[0.5em]{.}\contentspage}

% ---------------- Хуудасны дугаар ----------------
\RequirePackage{fancyhdr}
\fancypagestyle{shutis}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\pagenofont\fontsize{11}{13}\selectfont\thepage}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\pagenofont\fontsize{11}{13}\selectfont\thepage}}
\pagestyle{shutis}

% ---------------- Жагсаалт ----------------
\RequirePackage{enumitem}
\setlist{itemsep=2pt, topsep=2pt, parsep=0pt}
\setlist[itemize]{label=\textbullet, leftmargin=2.2em}
\setlist[enumerate]{label=\arabic*., leftmargin=2.2em}

% ---------------- Хүснэгт, зураг, код ----------------
\RequirePackage{array, longtable, booktabs, float, graphicx}
\RequirePackage{caption}
\captionsetup{labelsep=period, font=normalsize, justification=centering, skip=6pt}
\captionsetup[table]{position=top}
\renewcommand{\figurename}{Зураг}
\renewcommand{\tablename}{Хүснэгт}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.25}
\arrayrulecolor{tablerule}
% Баганын өргөн: \col{0.3} = мөрийн 30%
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{\dimexpr#1\linewidth-2\tabcolsep-1.2\arrayrulewidth\relax}}

\RequirePackage{fvextra}
% Код: Pygments-ээр урьдчилан өнгөлсөн Verbatim (shell-escape шаардлагагүй)
\DeclareCaptionType[fileext=loc]{codeblock}[Код][Кодын жагсаалт]
\captionsetup[codeblock]{labelfont=bf, position=top, skip=4pt}
\fvset{fontsize=\fontsize{10}{12.6}\selectfont, frame=single, rulecolor=\color{tablerule}, framerule=0.5pt,
       framesep=5pt, breaklines=true, breaksymbolleft={\textcolor{codecm}{$\hookrightarrow$}}, tabsize=4}
\InputIfFileExists{codestyle.tex}{}{}
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\kbd}[1]{{\setlength{\fboxsep}{1.2pt}\setlength{\fboxrule}{0.4pt}\fbox{\fontsize{9}{10}\selectfont\ttfamily #1}}}

% ---------------- TikZ: диаграм ба browser хүрээ ----------------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, backgrounds, fit}
% \browsershot[url]{өргөн}{зураг}
\newcommand{\browsershot}[3][localhost:8000]{%
\begin{tikzpicture}[baseline=(current bounding box.north)]
  \node[inner sep=0pt, anchor=north west] (img) at (0,0) {\includegraphics[width=#2]{#3}};
  \coordinate (tl) at ([yshift=0.42cm]img.north west);
  \begin{scope}
    \clip[rounded corners=4pt] (tl) rectangle (img.south east);
    \fill[barfill] (tl) rectangle (img.north east);
  \end{scope}
  \draw[barline, line width=0.4pt] (img.north west) -- (img.north east);
  \fill[red!65!orange] ([xshift=0.26cm, yshift=0.21cm]img.north west) circle (0.055cm);
  \fill[orange!70!yellow] ([xshift=0.46cm, yshift=0.21cm]img.north west) circle (0.055cm);
  \fill[green!60!black!80] ([xshift=0.66cm, yshift=0.21cm]img.north west) circle (0.055cm);
  \path let \p1 = ($(img.north east)-(img.north west)$) in
    node[draw=barline, fill=white, rounded corners=3pt, minimum width=0.42*\x1, minimum height=0.25cm,
         inner sep=0pt, font=\fontsize{5}{6}\selectfont\ttfamily\color{black!60}]
      at ($(img.north west)!0.5!(img.north east) + (0,0.21cm)$) {#1};
  \draw[frameline, line width=0.5pt, rounded corners=4pt] (tl) rectangle (img.south east);
  \begin{pgfonlayer}{background}
    \fill[black!10, rounded corners=4pt] ([xshift=0.5pt, yshift=-1.2pt]tl) rectangle ([xshift=0.8pt, yshift=-1.6pt]img.south east);
  \end{pgfonlayer}
\end{tikzpicture}}
\tikzset{
  box/.style={draw=black!25, fill=black!2, rounded corners=5pt, align=center, inner sep=5pt,
              font=\small, minimum height=1.9cm, text width=3.9cm},
  flow/.style={-{Stealth[length=2.2mm]}, draw=headblue, line width=0.6pt},
  lbl/.style={font=\scriptsize, text=headblue},
}

% ---------------- Холбоос ----------------
\RequirePackage{xurl}
\RequirePackage[hidelinks, unicode, bookmarksnumbered]{hyperref}

